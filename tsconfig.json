{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src"],
    "include": ["src/**/*", "src/custom.d.ts"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react"
  },
  "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@view/*": ["view/*"],
      "@app/*": ["app/*"],
      "@service/*": ["service/*"],
      "@assets/*": [
        "../public/assets/*"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}