{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@view/*": ["view/*"],
      "@app/*": ["app/*"],
      "@service/*": ["service/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}